allow platform_app vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app vendor_camera_data_file:file { getattr open read };

allow platform_app apusys_device:chr_file rw_file_perms;

allow platform_app app_data_file:file execute;

allow platform_app proc_stat:file r_file_perms;

# Properties
get_prop(platform_app, vendor_mtk_camera_prop)

# JPEG reprocessing goes through the MTK ISP HAL
# (vendor.mediatek.hardware.camera.isphal::IISPModule).
hal_client_domain(platform_app, hal_mtk_bgs)
# Android 16+ runs platform apps in per-target-SDK domains; join the HAL client
# attribute so the hal_attribute_hwservice neverallow exempts them.
typeattribute platform_app hal_mtk_bgs_client;
typeattribute platform_app_36 hal_mtk_bgs_client;
binder_call(platform_app, hal_mtk_bgs_server)
binder_call(platform_app_36, hal_mtk_bgs_server)

# The AIDL ISP HAL is a camera HAL service; join hal_camera_client so the
# plat neverallow on hal_camera_service lets the camera look it up.
hal_client_domain(platform_app, hal_camera)
hal_client_domain(platform_app_36, hal_camera)
allow platform_app_36 mtk_hal_bgs_hwservice:hwservice_manager find;
